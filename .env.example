# tessera settings. Copy to .env (gitignored) and fill in what you use; every
# key is optional. The tools find .env by walking up from the current folder
# (then from their own), so a workspace that nests this checkout can keep its
# .env one level up. A variable set in the environment wins over this file.
# `npm run setup` in server/poll-worker writes the poll-service lines for you.

# The template a new deck starts from. Default: template.html in this checkout.
TESSERA_TEMPLATE=

# The folder that holds your decks. Default: decks (gitignored).
TESSERA_DECKS=decks

# Your poll service (docs/server-setup.md): new decks put it in doc.poll.service.
# Written by `npm run setup`. Example: https://join.<subdomain>.workers.dev
TESSERA_POLL_SERVICE=

# The lecturer key set on that service (its LECTURER_PASSWORD secret). Unlocks
# results and presenter controls. Written by `npm run setup`; also read from
# LECTURER_KEY. Never put it in a deck, and never commit this file.
TESSERA_LECTURER_KEY=

# OpenRouter API key, for the tools that call a model (image generation). The
# poll service keeps its own copy as a Cloudflare secret.
OPENROUTER_API_KEY=

# The <subdomain> of <subdomain>.workers.dev on your Cloudflare account, used
# for published deck links. Written by `npm run setup`.
TESSERA_CF_SUBDOMAIN=

# The public address of the live mirror (optional; leave empty to watch locally).
TESSERA_LIVE_URL=

# The address the live-mirror server listens on. Default: http://127.0.0.1:8000
TESSERA_LIVE_LOCAL=http://127.0.0.1:8000

# The name written as the author of editor requests and decks (optional).
TESSERA_AUTHOR=

# Optional: the tagline md_to_deck.py puts on section slides whose spec gives none.
TESSERA_SECTION_TAGLINE=

# Copies a tool keeps in <deck folder>/build/backups/ before rewriting a deck (0 = none).
# TESSERA_BACKUPS=3
